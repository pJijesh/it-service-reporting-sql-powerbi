// =============================================================================================
// DAX measures for the IT service report.
//
// STATUS: NOT RUN IN POWER BI DESKTOP. The function names and syntax were checked against the DAX
// reference on Microsoft Learn (list in powerbi/README.md). The measures have not been evaluated by a
// DAX engine, so expect to fix small things on first use. tests/test_powerbi_spec.py checks the file for
// balanced brackets, allowed function names and a documentation header on every measure. It does not
// execute DAX.
//
// How to use: create an empty table called _Measures, then add each measure to it by typing the
// text "Name = expression" into the formula bar. Apply the format shown in each header.
//
// Model assumptions (see data-model.md)
//   FactTicket     one row per ticket, loaded from model/fact_ticket.csv
//   DimDate        one row per day. Active relationship: DimDate[date] to FactTicket[opened_date].
//                  Inactive relationship: DimDate[date] to FactTicket[resolved_date].
//   DimSite, DimTeam, DimPriority, DimTicketType: ordinary dimensions on the fact table.
//
// Cohorts. Measures about service levels and volume count a ticket in the month it was OPENED (the active
// relationship). Measures about time to resolve, first contact fix, reopening and satisfaction count a
// ticket in the month it was RESOLVED, by switching to the inactive relationship with USERELATIONSHIP.
// This matches the SQL views in sql/views, so Power BI and SQL give the same numbers.
//
// Ratios are always built as DIVIDE ( sum, sum ), never as an average of percentages, so that totals,
// rolling windows and filtered views stay correct.
//
// The month-based measures (prior month, rolling three months, period end) are written for visuals and
// slicers at month grain. They take the last date in the current filter context and work from the calendar
// month of that date.
// =============================================================================================


// ---------------------------------------------------------------------------------------------
// VOLUME
// ---------------------------------------------------------------------------------------------

// Tickets Opened
// Answers: how much demand arrived? Counts tickets of every type, by the date they were opened.
// Format: whole number.
Tickets Opened = COUNTROWS ( FactTicket )


// Tickets Resolved
// Answers: how much work was finished? Counts tickets by the date they were resolved. Tickets with no
// resolution time are excluded by the is_open test.
// Format: whole number.
Tickets Resolved =
CALCULATE (
    COUNTROWS ( FactTicket ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[is_open] = 0
)


// Tickets Opened Prior Month
// Answers: what was demand last month? Uses the calendar month before the last date in context.
// Format: whole number.
Tickets Opened Prior Month =
VAR PriorMonthStart = EOMONTH ( MAX ( DimDate[date] ), -2 ) + 1
VAR PriorMonthEnd = EOMONTH ( MAX ( DimDate[date] ), -1 )
RETURN
    CALCULATE (
        [Tickets Opened],
        REMOVEFILTERS ( DimDate ),
        DimDate[date] >= PriorMonthStart,
        DimDate[date] <= PriorMonthEnd
    )


// Tickets Opened MoM %
// Answers: is demand rising or falling against last month? Blank when there is no prior month.
// Format: 0.0%.
Tickets Opened MoM % =
VAR CurrentMonth = [Tickets Opened]
VAR PriorMonth = [Tickets Opened Prior Month]
RETURN
    DIVIDE ( CurrentMonth - PriorMonth, PriorMonth )


// Tickets Opened Rolling 3M Average
// Answers: what is the underlying monthly demand once one-off months are smoothed out? Total opened in the
// three calendar months ending with the current month, divided by three. Blank until three months exist.
// Format: 0.0.
Tickets Opened Rolling 3M Average =
VAR WindowStart = EOMONTH ( MAX ( DimDate[date] ), -3 ) + 1
VAR WindowEnd = EOMONTH ( MAX ( DimDate[date] ), 0 )
VAR FirstDate = CALCULATE ( MIN ( DimDate[date] ), REMOVEFILTERS ( DimDate ) )
RETURN
    IF (
        WindowStart < FirstDate,
        BLANK (),
        DIVIDE (
            CALCULATE (
                [Tickets Opened],
                REMOVEFILTERS ( DimDate ),
                DimDate[date] >= WindowStart,
                DimDate[date] <= WindowEnd
            ),
            3
        )
    )


// ---------------------------------------------------------------------------------------------
// SERVICE LEVELS (cohort: month opened)
// ---------------------------------------------------------------------------------------------

// Response Measured
// Answers: how many tickets have a response outcome? Counts incidents and service requests that were either
// answered, or are unanswered and already past target. Tickets still inside target are not counted.
// The flag is worked out in the SQL view fact_ticket.
// Format: whole number.
Response Measured = SUM ( FactTicket[response_measured] )


// Response Met
// Answers: how many of those were answered within target? A response exactly on target counts as met.
// Format: whole number.
Response Met = SUM ( FactTicket[response_met] )


// Response Met %
// Answers: what share of tickets got a response within target? This is the response service level.
// Format: 0.0%.
Response Met % = DIVIDE ( [Response Met], [Response Measured] )


// Resolution Measured
// Answers: how many tickets have a resolution outcome? Resolved tickets, plus open tickets already past
// target. Open tickets still inside target ("in flight") are left out until they have an outcome.
// Format: whole number.
Resolution Measured = SUM ( FactTicket[resolution_measured] )


// Resolution Met
// Answers: how many of those were resolved within target?
// Format: whole number.
Resolution Met = SUM ( FactTicket[resolution_met] )


// Resolution Met %
// Answers: what share of tickets were resolved within target? This is the headline service level.
// Format: 0.0%.
Resolution Met % = DIVIDE ( [Resolution Met], [Resolution Measured] )


// Resolution Missed
// Answers: how many tickets breached their resolution target? Useful as a count beside the percentage,
// because a small percentage move on a large volume is many tickets.
// Format: whole number.
Resolution Missed = [Resolution Measured] - [Resolution Met]


// Resolution In Flight
// Answers: how many tickets are still open and still inside target, so cannot be judged yet? Show this
// beside the percentage for the most recent month, where it is largest.
// Format: whole number.
Resolution In Flight =
CALCULATE (
    COUNTROWS ( FactTicket ),
    FactTicket[resolution_state] = "in_flight"
)


// P1 Resolution Met %
// Answers: how did the most serious incidents do? Resolution service level for P1 incidents only. The
// number of P1 tickets is small, so show the count (Resolution Measured) next to it.
// Format: 0.0%.
P1 Resolution Met % =
CALCULATE (
    [Resolution Met %],
    FactTicket[ticket_type] = "incident",
    FactTicket[priority] = "P1"
)


// Resolution Met % Prior Month
// Answers: what was the resolution service level last month? Calendar month before the last date in context.
// Format: 0.0%.
Resolution Met % Prior Month =
VAR PriorMonthStart = EOMONTH ( MAX ( DimDate[date] ), -2 ) + 1
VAR PriorMonthEnd = EOMONTH ( MAX ( DimDate[date] ), -1 )
RETURN
    CALCULATE (
        [Resolution Met %],
        REMOVEFILTERS ( DimDate ),
        DimDate[date] >= PriorMonthStart,
        DimDate[date] <= PriorMonthEnd
    )


// Resolution Met % MoM Change (pts)
// Answers: did the service level improve or worsen since last month, in percentage points? Not a
// percentage change: 90% to 92% is +2.0 points. Blank if either month has no data.
// Format: +0.0;-0.0;0.0
Resolution Met % MoM Change (pts) =
VAR CurrentMonth = [Resolution Met %]
VAR PriorMonth = [Resolution Met % Prior Month]
RETURN
    IF ( ISBLANK ( CurrentMonth ) || ISBLANK ( PriorMonth ), BLANK (), ( CurrentMonth - PriorMonth ) * 100 )


// Resolution Met % Rolling 3M
// Answers: what is the service level over the last three months, smoothing one-off dips? It adds up the
// counts for three calendar months and divides once. It is not the average of three monthly percentages.
// Blank until three months of data exist.
// Format: 0.0%.
Resolution Met % Rolling 3M =
VAR WindowStart = EOMONTH ( MAX ( DimDate[date] ), -3 ) + 1
VAR WindowEnd = EOMONTH ( MAX ( DimDate[date] ), 0 )
VAR FirstDate = CALCULATE ( MIN ( DimDate[date] ), REMOVEFILTERS ( DimDate ) )
RETURN
    IF (
        WindowStart < FirstDate,
        BLANK (),
        CALCULATE (
            [Resolution Met %],
            REMOVEFILTERS ( DimDate ),
            DimDate[date] >= WindowStart,
            DimDate[date] <= WindowEnd
        )
    )


// Response Met % Prior Month
// Answers: what was the response service level last month?
// Format: 0.0%.
Response Met % Prior Month =
VAR PriorMonthStart = EOMONTH ( MAX ( DimDate[date] ), -2 ) + 1
VAR PriorMonthEnd = EOMONTH ( MAX ( DimDate[date] ), -1 )
RETURN
    CALCULATE (
        [Response Met %],
        REMOVEFILTERS ( DimDate ),
        DimDate[date] >= PriorMonthStart,
        DimDate[date] <= PriorMonthEnd
    )


// Response Met % MoM Change (pts)
// Answers: did response performance improve or worsen since last month, in percentage points?
// Format: +0.0;-0.0;0.0
Response Met % MoM Change (pts) =
VAR CurrentMonth = [Response Met %]
VAR PriorMonth = [Response Met % Prior Month]
RETURN
    IF ( ISBLANK ( CurrentMonth ) || ISBLANK ( PriorMonth ), BLANK (), ( CurrentMonth - PriorMonth ) * 100 )


// Response Met % Rolling 3M
// Answers: what is the response service level over the last three months? Ratio of summed counts.
// Format: 0.0%.
Response Met % Rolling 3M =
VAR WindowStart = EOMONTH ( MAX ( DimDate[date] ), -3 ) + 1
VAR WindowEnd = EOMONTH ( MAX ( DimDate[date] ), 0 )
VAR FirstDate = CALCULATE ( MIN ( DimDate[date] ), REMOVEFILTERS ( DimDate ) )
RETURN
    IF (
        WindowStart < FirstDate,
        BLANK (),
        CALCULATE (
            [Response Met %],
            REMOVEFILTERS ( DimDate ),
            DimDate[date] >= WindowStart,
            DimDate[date] <= WindowEnd
        )
    )


// ---------------------------------------------------------------------------------------------
// TARGETS AND STATUS
// ---------------------------------------------------------------------------------------------

// Resolution Target %
// Answers: what is the target line? A constant for reference lines and the status measure. The value is an
// example from this repository. In a real model, hold targets in a table so that the owner can change them
// without editing DAX.
// Format: 0%.
Resolution Target % = 0.92


// Response Target %
// Answers: what is the target line for response? Same caution as above.
// Format: 0%.
Response Target % = 0.92


// Resolution Status
// Answers: is the service level on target, in words? Text is used so that status does not depend on colour
// alone. "No data" when there are no measured tickets.
// Format: text.
Resolution Status =
VAR CurrentValue = [Resolution Met %]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( CurrentValue ), "No data",
        CurrentValue >= [Resolution Target %], "Met",
        "Not met"
    )


// ---------------------------------------------------------------------------------------------
// TIME TO RESOLVE (cohort: month resolved)
// ---------------------------------------------------------------------------------------------

// Incidents Resolved
// Answers: how many incidents were finished? Counts resolved incidents with a valid timeline, by the date
// they were resolved. This is the denominator of MTTR.
// Format: whole number.
Incidents Resolved =
CALCULATE (
    COUNTROWS ( FactTicket ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[ticket_type] = "incident",
    FactTicket[is_open] = 0,
    FactTicket[timeline_ok] = 1
)


// Resolution Clock Minutes of Resolved Incidents
// Answers: how much clock time did those incidents use in total? Sum of the resolution clock: elapsed minutes
// for P1, support-hours minutes for the rest. This is the numerator of MTTR. Kept as a measure so that the
// totals combine correctly across any filter.
// Format: whole number.
Resolution Clock Minutes of Resolved Incidents =
CALCULATE (
    SUM ( FactTicket[resolution_clock_minutes] ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[ticket_type] = "incident",
    FactTicket[is_open] = 0,
    FactTicket[timeline_ok] = 1
)


// MTTR (hours)
// Answers: on average, how long did incidents take to resolve? Mean time to resolve in clock hours (support
// hours except P1). A mean is pulled up by a few very slow tickets, so read it with the median in the SQL
// view mttr_percentiles.
// Format: 0.0.
MTTR (hours) = DIVIDE ( [Resolution Clock Minutes of Resolved Incidents], [Incidents Resolved] ) / 60


// MTTR (hours) Prior Month
// Answers: what was MTTR last month?
// Format: 0.0.
MTTR (hours) Prior Month =
VAR PriorMonthStart = EOMONTH ( MAX ( DimDate[date] ), -2 ) + 1
VAR PriorMonthEnd = EOMONTH ( MAX ( DimDate[date] ), -1 )
RETURN
    CALCULATE (
        [MTTR (hours)],
        REMOVEFILTERS ( DimDate ),
        DimDate[date] >= PriorMonthStart,
        DimDate[date] <= PriorMonthEnd
    )


// MTTR (hours) MoM Change %
// Answers: did incidents take longer or shorter than last month, as a percentage? Positive means slower.
// Format: +0.0%;-0.0%;0.0%
MTTR (hours) MoM Change % =
VAR CurrentMonth = [MTTR (hours)]
VAR PriorMonth = [MTTR (hours) Prior Month]
RETURN
    DIVIDE ( CurrentMonth - PriorMonth, PriorMonth )


// MTTR (hours) Rolling 3M
// Answers: what is MTTR over three months? Total clock minutes divided by total incidents across the
// window, not an average of monthly means. Blank until three months of data exist.
// Format: 0.0.
MTTR (hours) Rolling 3M =
VAR WindowStart = EOMONTH ( MAX ( DimDate[date] ), -3 ) + 1
VAR WindowEnd = EOMONTH ( MAX ( DimDate[date] ), 0 )
VAR FirstDate = CALCULATE ( MIN ( DimDate[date] ), REMOVEFILTERS ( DimDate ) )
RETURN
    IF (
        WindowStart < FirstDate,
        BLANK (),
        CALCULATE (
            [MTTR (hours)],
            REMOVEFILTERS ( DimDate ),
            DimDate[date] >= WindowStart,
            DimDate[date] <= WindowEnd
        )
    )


// ---------------------------------------------------------------------------------------------
// BACKLOG
// ---------------------------------------------------------------------------------------------

// Open Tickets Now
// Answers: how many tickets are open at the extract time? Ignores the date selection, because a ticket
// opened in an earlier month is still open now. Backlog means not yet resolved.
// Format: whole number.
Open Tickets Now =
CALCULATE (
    COUNTROWS ( FactTicket ),
    FactTicket[is_open] = 1,
    REMOVEFILTERS ( DimDate )
)


// Open Over 30 Days
// Answers: how many open tickets are old? Open at the extract time and more than 30 days old (the
// "Over 30 days" bucket in the SQL view backlog_ageing).
// Format: whole number.
Open Over 30 Days =
CALCULATE (
    COUNTROWS ( FactTicket ),
    FactTicket[is_open] = 1,
    FactTicket[open_age_days] > 30,
    REMOVEFILTERS ( DimDate )
)


// Open Past Target
// Answers: how many open tickets have already breached their resolution target? Problems and changes have
// no target, so they never appear here.
// Format: whole number.
Open Past Target =
CALCULATE (
    COUNTROWS ( FactTicket ),
    FactTicket[is_open] = 1,
    FactTicket[resolution_state] = "breached",
    REMOVEFILTERS ( DimDate )
)


// Backlog at Period End
// Answers: how many tickets were open at the end of the month? A ticket is open at that moment if it was
// opened before it and not resolved before it. Uses the last date in context, so use it at month grain.
// DimDate is cleared inside CALCULATE so that tickets opened in earlier months are included. Other filters
// (company, team, type) still apply.
// Format: whole number.
Backlog at Period End =
VAR PeriodEnd = MAX ( DimDate[date] ) + 1
RETURN
    CALCULATE (
        COUNTROWS (
            FILTER (
                FactTicket,
                FactTicket[opened_at] < PeriodEnd
                    && ( ISBLANK ( FactTicket[resolved_at] ) || FactTicket[resolved_at] >= PeriodEnd )
            )
        ),
        REMOVEFILTERS ( DimDate )
    )


// Backlog at Prior Month End
// Answers: how many tickets were open at the end of the previous month?
// Format: whole number.
Backlog at Prior Month End =
VAR PeriodEnd = EOMONTH ( MAX ( DimDate[date] ), -1 ) + 1
RETURN
    CALCULATE (
        COUNTROWS (
            FILTER (
                FactTicket,
                FactTicket[opened_at] < PeriodEnd
                    && ( ISBLANK ( FactTicket[resolved_at] ) || FactTicket[resolved_at] >= PeriodEnd )
            )
        ),
        REMOVEFILTERS ( DimDate )
    )


// Backlog MoM Change
// Answers: is the backlog growing? Open tickets at this month end minus open tickets at the last month end.
// Positive means growth. Blank for the first month, where the prior position is not in the data.
// Format: +0;-0;0
Backlog MoM Change =
VAR CurrentBacklog = [Backlog at Period End]
VAR PriorBacklog = [Backlog at Prior Month End]
RETURN
    IF ( ISBLANK ( PriorBacklog ), BLANK (), CurrentBacklog - PriorBacklog )


// ---------------------------------------------------------------------------------------------
// QUALITY (cohort: month resolved; incidents and service requests)
// ---------------------------------------------------------------------------------------------

// Resolved Incidents and Requests
// Answers: how many tickets does each quality measure divide by? Resolved incidents and service requests
// with a valid timeline, by resolution date. Problems and changes are left out.
// Format: whole number.
Resolved Incidents and Requests =
CALCULATE (
    COUNTROWS ( FactTicket ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[ticket_type] IN { "incident", "service_request" },
    FactTicket[is_open] = 0,
    FactTicket[timeline_ok] = 1
)


// Fixed at First Contact
// Answers: how many of those were resolved by first-line staff at the first interaction, with no hand-off?
// The flag comes from the ticketing tool, so its definition is the tool's.
// Format: whole number.
Fixed at First Contact =
CALCULATE (
    SUM ( FactTicket[resolved_first_contact] ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[ticket_type] IN { "incident", "service_request" },
    FactTicket[is_open] = 0,
    FactTicket[timeline_ok] = 1
)


// FTF %
// Answers: what share of resolved tickets were fixed at first contact? First time fix rate.
// Format: 0.0%.
FTF % = DIVIDE ( [Fixed at First Contact], [Resolved Incidents and Requests] )


// Reopened Tickets
// Answers: how many resolved tickets came back? Counts the reopened flag on tickets resolved in the period.
// The latest month is provisional because recent tickets have had less time to be reopened.
// Format: whole number.
Reopened Tickets =
CALCULATE (
    SUM ( FactTicket[reopened] ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[ticket_type] IN { "incident", "service_request" },
    FactTicket[is_open] = 0,
    FactTicket[timeline_ok] = 1
)


// Reopen %
// Answers: how often is a fix not a fix? Share of resolved tickets that were reopened.
// Format: 0.0%.
Reopen % = DIVIDE ( [Reopened Tickets], [Resolved Incidents and Requests] )


// CSAT Responses
// Answers: how many people answered the survey? COUNT ignores blanks, so tickets with no response are not
// counted. Always show this beside the score: a score from few responses is not a trend.
// Format: whole number.
CSAT Responses =
CALCULATE (
    COUNT ( FactTicket[csat] ),
    USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
    FactTicket[ticket_type] IN { "incident", "service_request" },
    FactTicket[is_open] = 0,
    FactTicket[timeline_ok] = 1
)


// CSAT Average
// Answers: how satisfied were the people who answered? Mean score from 1 to 5 across responses.
// Format: 0.00.
CSAT Average =
DIVIDE (
    CALCULATE (
        SUM ( FactTicket[csat] ),
        USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
        FactTicket[ticket_type] IN { "incident", "service_request" },
        FactTicket[is_open] = 0,
        FactTicket[timeline_ok] = 1
    ),
    [CSAT Responses]
)


// CSAT Satisfied %
// Answers: what share of responses were positive? Responses scoring 4 or 5, divided by all responses.
// Often easier for a board to read than an average.
// Format: 0.0%.
CSAT Satisfied % =
DIVIDE (
    CALCULATE (
        COUNTROWS ( FactTicket ),
        USERELATIONSHIP ( FactTicket[resolved_date], DimDate[date] ),
        FactTicket[ticket_type] IN { "incident", "service_request" },
        FactTicket[is_open] = 0,
        FactTicket[timeline_ok] = 1,
        FactTicket[csat] >= 4
    ),
    [CSAT Responses]
)


// CSAT Response Rate
// Answers: how representative is the score? Responses divided by resolved tickets.
// Format: 0.0%.
CSAT Response Rate = DIVIDE ( [CSAT Responses], [Resolved Incidents and Requests] )


// ---------------------------------------------------------------------------------------------
// LABELS
// ---------------------------------------------------------------------------------------------

// Selected Month Label
// Answers: which month is on the page? The single month selected in a slicer, or "All months".
// Format: text.
Selected Month Label = SELECTEDVALUE ( DimDate[year_month], "All months" )


// Report Title
// Answers: nothing by itself. Use it as a dynamic visual title so that the page names the month shown.
// Format: text.
Report Title = "IT service report: " & [Selected Month Label]
